# Somente no servidor. Copie para .env.local (ignorado) para desenvolvimento.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=CONFIGURE_NO_SERVIDOR
# Gere 32 bytes aleatórios; não reutilize como chave pública.
RATE_LIMIT_SECRET=CONFIGURE_UM_SEGREDO_ALEATORIO_DE_32_BYTES
ALLOWED_ORIGINS=http://localhost:3000,https://SEU-SITE.vercel.app

# Download privado: configurar somente depois de criar o autenticador e Blob privado.
DOWNLOAD_TOTP_SECRET=CONFIGURE_O_SEGREDO_BASE32_LOCAL
APK_BLOB_PATH=releases/CraftBunny-Android-0.3.5.apk
APK_DOWNLOAD_VERSION=0.3.5
APK_DOWNLOAD_SHA256=A4582F7A33EA9DF76036E5C8A1FB903D52FAC30BFED046F18C1576531D785150
# BLOB_STORE_ID é adicionado pela integração da Vercel (OIDC).
# Para upload local, use BLOB_READ_WRITE_TOKEN somente no ambiente privado.
